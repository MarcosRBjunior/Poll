# Copie para .env e preencha. Nada secreto com prefixo NEXT_PUBLIC_.
# O schema em src/lib/env.ts só exige as variáveis da fase em curso.

# Banco (F2). Local: postgresql://poll:poll@localhost:5440/poll nas duas.
# Prisma Postgres: DIRECT_URL com host db.prisma.io (migrações). DATABASE_URL deveria usar
# pooled.db.prisma.io; hoje, na Vercel, ela é a direta da integração (pendência da F9).
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (F3) — só a chave publicável; nenhuma chave de serviço no app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Único e-mail com papel ADMIN (F3)
ADMIN_EMAIL=

# Segredo do HMAC de IP e token do respondente (F4)
RESPONDENT_KEY_SECRET=

# Opcionais
SENTRY_DSN=
RATE_LIMIT_REDIS_URL=
