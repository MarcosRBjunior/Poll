# Copie para .env e preencha. Nada secreto com prefixo NEXT_PUBLIC_.
# O schema em src/lib/env.ts só exige as variáveis da fase em curso.

# Banco (F2). Local: postgresql://poll:poll@localhost:5440/poll nas duas.
# Prisma Postgres: DATABASE_URL e DIRECT_URL com host db.prisma.io (a integração da Vercel
# cria DATABASE_URL assim); DATABASE_URL_POOLED com pooled.db.prisma.io, mesmo usuário e senha.
# Com DATABASE_URL_POOLED, o app usa o pool; as migrações sempre usam DIRECT_URL.
DATABASE_URL=
DATABASE_URL_POOLED=
DIRECT_URL=

# Supabase Auth (F3) — só a chave publicável; nenhuma chave de serviço no app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Único e-mail com papel ADMIN (F3)
ADMIN_EMAIL=

# Segredo do HMAC de IP e token do respondente (F4)
RESPONDENT_KEY_SECRET=

# Projeto Supabase de TESTE (só testes; local em .env.test.local, no CI em secrets).
# Login por senha ligado e dois usuários criados à mão: um com TEST_ADMIN_EMAIL, outro comum.
# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=

# Opcionais
SENTRY_DSN=
RATE_LIMIT_REDIS_URL=
